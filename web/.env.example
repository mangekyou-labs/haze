# ─── Web app environment (stellar-launch M3.3) ─────────────────
#
# For local dev: copy to `.env.local` and fill in.
# For Vercel: set each var in Settings → Environment Variables or
# via `vercel env add`. `web/vercel.json` contains deployment settings only;
# this file is the environment-variable inventory.
#
# `next start` (production mode) REQUIRES AUTH_SECRET — without it
# next-auth v5 throws MissingSecret and every page 500s via the
# session endpoint. Generate: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth app (https://github.com/settings/developers).
# Without these the sign-in button is disabled with an explanation.
# Callback URL: https://<vercel-url>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe test mode (checkout + webhook relay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gateway integration (server-side)
# GATEWAY_URL: internal URL the web server uses for contract-status proxying.
# GATEWAY_SECRET: shared secret for webhook relay auth and withdrawal requests.
GATEWAY_URL=http://localhost:3001
GATEWAY_SECRET=

# Level 4 participant identity (server-only). Generate at least 32 random
# bytes and do not reuse GATEWAY_SECRET.
EVALUATION_HMAC_SECRET=

# Optional, explicit-opt-in analytics. NEXT_PUBLIC_* values are browser-visible.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional Sentry projects. Keep the server DSN separate from the browser DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_RELEASE_SHA=

# Public base URL shown in the dashboard API-key setup snippet
# (defaults to http://localhost:3001 when unset)
NEXT_PUBLIC_GATEWAY_URL=
